{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "1100px",
            "wideSize": "1320px"
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                { "slug": "background",     "color": "#12100c", "name": "Background — Warm Near-Black" },
                { "slug": "surface",        "color": "#1b1712", "name": "Surface — Warm Slate" },
                { "slug": "subtle",         "color": "#2a241c", "name": "Subtle Border — Warm" },
                { "slug": "foreground",     "color": "#efe9df", "name": "Foreground — Warm Off-White" },
                { "slug": "muted",          "color": "#a89f8f", "name": "Muted — Warm Gray" },
                { "slug": "primary",        "color": "#f43f5e", "name": "Dragon Pink" },
                { "slug": "primary-soft",   "color": "#fda4af", "name": "Dragon Pink — Soft" },
                { "slug": "accent",         "color": "#e11d48", "name": "Deep Pink" },
                { "slug": "accent-soft",    "color": "#fecdd3", "name": "Dragon Pink — Bright" },
                { "slug": "hot",            "color": "#f43f5e", "name": "Dragon Pink" },
                { "slug": "highlight",      "color": "#facc15", "name": "Sticky Yellow" }
            ],
            "gradients": [
                { "slug": "brand",       "name": "Dragon Pink",           "gradient": "linear-gradient(135deg, #f43f5e 0%, #e11d48 100%)" },
                { "slug": "brand-soft",  "name": "Dragon Pink Soft",      "gradient": "linear-gradient(135deg, #fda4af 0%, #fecdd3 100%)" },
                { "slug": "hot",         "name": "Hot (Violet → Pink)",   "gradient": "linear-gradient(135deg, #a855f7 0%, #f43f5e 100%)" },
                { "slug": "surface-card","name": "Surface Card",          "gradient": "linear-gradient(180deg, #1b1712 0%, #14110d 100%)" }
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "slug": "system",
                    "name": "System Sans",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif"
                },
                {
                    "slug": "mono",
                    "name": "Monospace",
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
                }
            ],
            "fontSizes": [
                { "slug": "small",    "size": "0.875rem", "name": "Small" },
                { "slug": "medium",   "size": "1.05rem",  "name": "Medium" },
                { "slug": "large",    "size": "1.5rem",   "name": "Large" },
                { "slug": "x-large",  "size": "clamp(2rem, 1.4rem + 2vw, 3rem)",        "name": "Extra Large", "fluid": false },
                { "slug": "xx-large", "size": "clamp(2.75rem, 1.5rem + 4vw, 4.5rem)",  "name": "XXL",         "fluid": false },
                { "slug": "display",  "size": "clamp(3rem, 1.5rem + 6vw, 6.5rem)",     "name": "Display",     "fluid": false }
            ]
        },
        "spacing": {
            "units": ["px", "em", "rem", "%", "vh", "vw"],
            "spacingScale": { "steps": 0 },
            "spacingSizes": [
                { "slug": "10", "size": "0.5rem", "name": "1 — XS" },
                { "slug": "20", "size": "1rem",   "name": "2 — S" },
                { "slug": "30", "size": "1.5rem", "name": "3 — M" },
                { "slug": "40", "size": "2rem",   "name": "4 — L" },
                { "slug": "50", "size": "3rem",   "name": "5 — XL" },
                { "slug": "60", "size": "5rem",   "name": "6 — 2XL" },
                { "slug": "70", "size": "8rem",   "name": "7 — 3XL" }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--foreground)"
        },
        "spacing": {
            "padding": {
                "left": "var(--wp--preset--spacing--30)",
                "right": "var(--wp--preset--spacing--30)"
            },
            "blockGap": "var(--wp--preset--spacing--30)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.65"
        },
        "elements": {
            "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "fontWeight": "800", "lineHeight": "1.02", "letterSpacing": "-0.025em" } },
            "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "800", "lineHeight": "1.1",  "letterSpacing": "-0.02em" } },
            "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)",   "fontWeight": "700", "lineHeight": "1.3" } },
            "h4": { "typography": { "fontSize": "1.15rem", "fontWeight": "600", "lineHeight": "1.4" } },
            "link": {
                "color":      { "text": "var(--wp--preset--color--primary-soft)" },
                ":hover":     { "color": { "text": "var(--wp--preset--color--accent-soft)" }, "typography": { "textDecoration": "underline" } },
                "typography": { "textDecoration": "none" }
            },
            "button": {
                "color":   { "background": "#e11d48", "text": "#ffffff" },
                "border":  { "radius": "999px" },
                "spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
                "typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--medium)" },
                ":hover":  { "color": { "background": "#f43f5e" } },
                ":focus":  { "color": { "background": "#f43f5e" } }
            }
        },
        "blocks": {
            "core/code": {
                "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" },
                "color": { "background": "var(--wp--preset--color--surface)" }
            }
        }
    },
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" }
    ],
    "customTemplates": [
        { "name": "page-privacy-policy", "title": "Privacy Policy",          "postTypes": [ "page" ] },
        { "name": "page-sitemap",        "title": "Sitemap",                 "postTypes": [ "page" ] },
        { "name": "page-demos",          "title": "Demos Hub",               "postTypes": [ "page" ] },
        { "name": "page-demo-contrast",  "title": "Demo — Contrast Checker", "postTypes": [ "page" ] },
        { "name": "page-demo-weather",   "title": "Demo — Weather API",      "postTypes": [ "page" ] },
        { "name": "page-demo-audio",     "title": "Demo — Audio Visualizer", "postTypes": [ "page" ] },
        { "name": "page-demo-sort",        "title": "Demo — Sort Race",        "postTypes": [ "page" ] },
        { "name": "page-demo-life",        "title": "Demo — Game of Life",     "postTypes": [ "page" ] },
        { "name": "page-demo-live-editor", "title": "Demo — Live Editor",      "postTypes": [ "page" ] },
        { "name": "page-demo-pug-attack",  "title": "Demo — Pug Attack",       "postTypes": [ "page" ] },
        { "name": "page-demo-microgame",   "title": "Demo — Microgame",        "postTypes": [ "page" ] },
        { "name": "page-demo-pokedex",     "title": "Demo — Pokédex",          "postTypes": [ "page" ] },
        { "name": "page-demo-card-browser","title": "Demo — Pokémon TCG Browser","postTypes": [ "page" ] },
        { "name": "page-demo-ant-buster",  "title": "Demo — Ant Buster",         "postTypes": [ "page" ] },
        { "name": "page-demo-prompt-studio","title": "Demo — Prompt Studio",    "postTypes": [ "page" ] },
        { "name": "page-projects",                  "title": "Projects Hub",                "postTypes": [ "page" ] },
        { "name": "page-project-space-dwarves",     "title": "Project — Space Dwarves",     "postTypes": [ "page" ] },
        { "name": "page-project-lost-probe",        "title": "Project — The Lost Probe",    "postTypes": [ "page" ] },
        { "name": "page-project-one-robot-army",    "title": "Project — One Robot Army",    "postTypes": [ "page" ] },
        { "name": "page-project-nickey-performance","title": "Project — NicKey Performance","postTypes": [ "page" ] },
        { "name": "page-project-dariobimbi-com",    "title": "Project — dariobimbi.com",    "postTypes": [ "page" ] }
    ]
}
