# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Logs
*.log

# Playwright MCP debug artifacts (page snapshots, console logs, screenshots).
# Generated when an agent uses the Playwright MCP tools to verify a demo in
# the browser. Useful in-session, never useful in history.
.playwright-mcp/

# Loose screenshots dropped at the theme root by debug runs. Real image
# assets live under assets/ and are not affected by these patterns.
/screenshot.png
/ab-*.png
/ant-buster-*.png

# Composer (dev-only IDE stubs, regenerable via `composer install`)
vendor/

# Lost Probe source media. Not referenced by the theme at runtime; only
# banner.png and banner-hero.png in this folder are read. The .avi, the
# two oversized .wmv screen captures, and The_Lost_Probe.exe were purged
# from history with git filter-repo to clear GitHub's 100 MB blob limit.
# Backups live on the user's Desktop, outside the repo.
assets/projects/lost-probe/*.avi
assets/projects/lost-probe/*.wmv
assets/projects/lost-probe/*.exe
